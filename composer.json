{
    "name": "tattali/mobile-detect-bundle",
    "description": "Symfony 8 bundle to detect mobile devices, manage mobile view and redirect to the mobile and tablet version.",
    "keywords": [
        "mobile detect",
        "device detect",
        "device detector",
        "mobile view managing",
        "mobiledetect",
        "mobiledetectbundle",
        "symfony mobile detect",
        "symfony mobiledetect",
        "symfony"
    ],
    "homepage": "https://github.com/tattali/MobileDetectBundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Théo Attali",
            "email": "theoattali@gmail.com"
        },
        {
            "name": "Nikolay Ivlev",
            "email": "nikolay.kotovsky@gmail.com"
        },
        {
            "name": "Henri Vesala",
            "email": "henri.vesala@gmail.com"
        },
        {
            "name": "netmikey",
            "homepage": "https://github.com/netmikey"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-filter": "*",
        "mobiledetect/mobiledetectlib": "^4.8",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "infection/infection": "^0.35",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/phpunit-bridge": "^8.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "MobileDetectBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MobileDetectBundle\\Tests\\": "tests/"
        }
    }
}
