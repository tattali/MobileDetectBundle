{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection.log"
    },
    "mutators": {
        "@default": true
    },
    // measured on 2026-10-18 (PHP 8.4, Symfony 7.4): MSI 85.96%, covered code MSI 85.96%; raise them when tests improve
    "minMsi": 85,
    "minCoveredMsi": 85
}
