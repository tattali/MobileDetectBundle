{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection.log"
    },
    "mutators": {
        "@default": true
    },
    // measured on 2026-10-18: MSI 80.1%, covered code MSI 82.5%; raise them when tests improve
    "minMsi": 80,
    "minCoveredMsi": 82
}
